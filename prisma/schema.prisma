generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  AVAILABLE
  PROMO
  RESERVED
  PENDING_APPROVAL
  SOLD
  IN_FITTING_ROOM
}

enum ReservationStatus {
  IN_CART
  PENDING
  ACCEPTED
  REJECTED
  AUTO_REJECTED
  FINALIZED
}

enum CustomerOrderStatus {
  PLACED
  PROCESSING
  READY
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  BLIK
  CARD_ONLINE
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentProvider {
  PRZELEWY24
  BANK_TRANSFER_MOCK
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  COD_PENDING
}

enum ShippingMethod {
  COURIER
  PARCEL_LOCKER_INPOST
  STORE_PICKUP
}

enum AddressBookEntryType {
  ADDRESS
  PARCEL_LOCKER
}

/// Rola użytkownika w sklepie (powiązanie z Supabase Auth `auth.users.id`).
enum ProfileRole {
  CUSTOMER
  STAFF
  OWNER
}

enum ProfileRank {
  BRONZE
  SILVER
  GOLD
  VINTAGE
}

enum PromoDiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum AiProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MarketingDraftStatus {
  DRAFT
  READY
  LAUNCHED
}

/// Profil aplikacji — `userId` = `sub` z JWT Supabase (UUID użytkownika).
model Profile {
  userId            String      @id @map("user_id") @db.Uuid
  email             String?
  role              ProfileRole @default(CUSTOMER)
  permissions       String[]    @default([])
  points            Int         @default(0)
  rank              ProfileRank @default(BRONZE)
  /// Zgoda marketingowa (newsletter / oferty) — osobno od konta sklepowego.
  newsletterOptIn   Boolean     @default(false) @map("newsletter_opt_in")
  /// Preferowany język UI (np. pl, en).
  preferredLocale   String      @default("pl") @map("preferred_locale")
  /// Unikalny kod polecający (np. do linku ?ref=).
  referralCode      String?     @unique @map("referral_code")
  referredByUserId  String?     @map("referred_by_user_id") @db.Uuid
  /// Segment marketingowy (DEFAULT, VIP, CHURN_RISK, …).
  customerSegment   String      @default("DEFAULT") @map("customer_segment")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  referredBy        Profile?    @relation("ProfileReferrals", fields: [referredByUserId], references: [userId], onDelete: SetNull)
  referrals         Profile[]   @relation("ProfileReferrals")

  @@map("profiles")
}

/// Karta podarunkowa (saldo w PLN).
model GiftCard {
  id             String   @id @default(uuid())
  code           String   @unique
  balanceAmount  Decimal  @map("balance_amount") @db.Decimal(12, 2)
  initialAmount  Decimal  @map("initial_amount") @db.Decimal(12, 2)
  currency       String   @default("PLN")
  active         Boolean  @default(true)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  orders         CustomerOrder[]

  @@map("gift_cards")
}

/// Strona CMS (regulamin, o nas, blog — treść Markdown).
model CmsPage {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  bodyMarkdown   String   @map("body_markdown") @db.Text
  published      Boolean  @default(false)
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description") @db.Text
  seoKeywords    String?  @map("seo_keywords")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String              @map("user_id") @db.Uuid
  subject   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  messages  SupportMessage[]

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id             String        @id @default(uuid())
  ticketId       String        @map("ticket_id")
  authorUserId   String?       @map("author_user_id") @db.Uuid
  body           String        @db.Text
  isStaff        Boolean       @default(false) @map("is_staff")
  createdAt      DateTime      @default(now()) @map("created_at")
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Wysłane przypomnienie o porzuconym koszyku (anty-spam: jedno / user / dzień).
model AbandonedCartReminder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.Uuid
  sentAt    DateTime @default(now()) @map("sent_at")

  @@index([userId, sentAt])
  @@map("abandoned_cart_reminders")
}

/// Eksperyment A/B (np. układ koszyka).
model Experiment {
  id        String   @id @default(uuid())
  key       String   @unique
  active    Boolean  @default(true)
  variants  Json     @default("[\"control\", \"variant_b\"]")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("experiments")
}

model ExperimentAssignment {
  id             String @id @default(uuid())
  userId         String @map("user_id") @db.Uuid
  experimentKey  String @map("experiment_key")
  variant        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, experimentKey])
  @@map("experiment_assignments")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id") @db.Uuid
  userEmail    String   @map("user_email")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model FinancialGoal {
  id           String   @id @default(uuid())
  month        String   @unique @db.VarChar(7)
  revenueTarget Decimal @map("revenue_target") @db.Decimal(12, 2)
  profitTarget Decimal  @map("profit_target") @db.Decimal(12, 2)
  fixedCosts   Decimal  @map("fixed_costs") @db.Decimal(12, 2)
  burnRate     Decimal  @map("burn_rate") @db.Decimal(12, 2)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([month])
  @@map("financial_goals")
}

model Supplier {
  id               String    @id @default(uuid())
  name             String    @unique
  paymentTermsDays Int?      @map("payment_terms_days")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  products         Product[]

  @@map("suppliers")
}

model AiProposal {
  id               String           @id @default(uuid())
  type             String
  status           AiProposalStatus @default(PENDING)
  productId        String?          @map("product_id")
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  currentPrice     Decimal          @map("current_price") @db.Decimal(12, 2)
  suggestedPrice   Decimal          @map("suggested_price") @db.Decimal(12, 2)
  discountPercent  Decimal          @map("discount_percent") @db.Decimal(5, 2)
  riskScore        Int              @map("risk_score")
  rationale        String           @db.Text
  acceptedAt       DateTime?        @map("accepted_at")
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  marketingLaunchedAt DateTime?     @map("marketing_launched_at")
  marketingDraft   MarketingDraft?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([productId, status])
  @@map("ai_proposals")
}

model MarketingDraft {
  id             String              @id @default(uuid())
  aiProposalId   String              @unique @map("ai_proposal_id")
  productId      String              @map("product_id")
  status         MarketingDraftStatus @default(DRAFT)
  caption        String              @db.Text
  suggestImage   String              @map("suggest_image")
  pushVintage    String              @map("push_vintage") @db.Text
  pushGold       String              @map("push_gold") @db.Text
  pushSilver     String              @map("push_silver") @db.Text
  launchedAt     DateTime?           @map("launched_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  aiProposal     AiProposal          @relation(fields: [aiProposalId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@map("marketing_drafts")
}

/// Produkt zsynchronizowany z Dotykačką (id_dotykacka = identyfikator w chmurze Dotykačka).
model Product {
  id          String        @id @default(uuid())
  idDotykacka String        @unique @map("id_dotykacka")
  name        String
  /// Krótki podtytuł na kafelku (jak w Shopify/Woo).
  subtitle    String?       @db.VarChar(512)
  price       Decimal       @db.Decimal(12, 2)
  purchasePriceNet Decimal? @map("purchase_price_net") @db.Decimal(12, 2)
  vatRate     Decimal?      @map("vat_rate") @db.Decimal(5, 2)
  marginTarget Decimal?     @map("margin_target") @db.Decimal(5, 2)
  supplierId  String?       @map("supplier_id")
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockQty    Int           @default(1) @map("stock_qty")
  status      ProductStatus @default(AVAILABLE)
  /// Sekcja „Polecane” na stronie głównej.
  isFeatured  Boolean       @default(false) @map("is_featured")
  reservations ProductReservation[]
  orderItems   CustomerOrderItem[]
  availabilityWatches AvailabilityWatch[]
  wishlistItems WishlistItem[]
  reviews      ProductReview[]
  aiProposals  AiProposal[]
  marketingDrafts MarketingDraft[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([supplierId])
  @@map("products")
}

model ProductReservation {
  id        String            @id @default(uuid())
  productId String            @map("product_id")
  ownerKey  String            @default("unknown") @map("owner_key")
  quantity  Int               @default(1)
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@unique([ownerKey, productId, status])
  @@map("product_reservations")
}

model CustomerOrder {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  status      CustomerOrderStatus @default(PLACED)
  /// Suma pozycji przed rabatem (subtotal).
  subtotalAmount Decimal          @db.Decimal(12, 2) @map("subtotal_amount")
  /// Kwota rabatu z kodu promocyjnego (0 jeśli brak).
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// Kwota do zapłaty po rabacie (zgodna z płatnością).
  totalAmount Decimal             @db.Decimal(12, 2) @map("total_amount")
  promoCodeId String?             @map("promo_code_id")
  promoCode   PromoCode?          @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoRedemption PromoRedemption?
  paymentMethod PaymentMethod     @default(BLIK) @map("payment_method")
  paymentProvider PaymentProvider @default(PRZELEWY24) @map("payment_provider")
  paymentStatus PaymentStatus     @default(PENDING) @map("payment_status")
  paymentReference String?        @map("payment_reference")
  paymentSessionUrl String?       @map("payment_session_url")
  paymentBankAccount String?      @map("payment_bank_account")
  paymentDetails Json             @default("{}") @map("payment_details")
  shippingMethod ShippingMethod   @default(COURIER) @map("shipping_method")
  shippingSnapshot Json           @map("shipping_snapshot")
  saveToAddressBook Boolean       @default(true) @map("save_to_address_book")
  /// Rabat z karty podarunkowej (w PLN).
  giftCardDiscountAmount Decimal   @default(0) @map("gift_card_discount_amount") @db.Decimal(12, 2)
  /// Rabat z programu poleceń (pierwsze zamówienie).
  referralDiscountAmount Decimal  @default(0) @map("referral_discount_amount") @db.Decimal(12, 2)
  giftCardId String?              @map("gift_card_id")
  referralCodeApplied String?      @map("referral_code_applied")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  items       CustomerOrderItem[]
  returnRequest ReturnRequest?
  giftCard    GiftCard?           @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  /// Uwagi klienta przy składaniu zamówienia (dostawa, prezent itd.).
  customerNote String?           @map("customer_note") @db.Text
  staffNotes   OrderStaffNote[]

  @@index([userId, createdAt])
  @@index([promoCodeId])
  @@map("customer_orders")
}

/// Notatki wewnętrzne personelu (widoczne tylko w panelu staff).
model OrderStaffNote {
  id           String          @id @default(uuid())
  orderId      String          @map("order_id")
  authorUserId String          @map("author_user_id") @db.Uuid
  body         String          @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  order        CustomerOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_staff_notes")
}

/// Wniosek klienta o zwrot (RMA) — jeden aktywny na zamówienie.
model ReturnRequest {
  id        String              @id @default(uuid())
  userId    String              @map("user_id") @db.Uuid
  orderId   String              @unique @map("order_id")
  reason    String              @db.Text
  status    ReturnRequestStatus @default(PENDING)
  staffNote String?             @map("staff_note") @db.Text
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  order     CustomerOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("return_requests")
}

/// Kody rabatowe — konfiguracja w panelu (staff).
model PromoCode {
  id              String           @id @default(uuid())
  code            String           @unique @map("code")
  label           String?
  discountType    PromoDiscountType @map("discount_type")
  /// Procent 0–100 (gdy discountType = PERCENT).
  percentOff      Decimal?         @map("percent_off") @db.Decimal(5, 2)
  /// Kwota PLN (gdy discountType = FIXED_AMOUNT).
  fixedOff        Decimal?         @map("fixed_off") @db.Decimal(12, 2)
  minOrderAmount  Decimal          @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxUses         Int?             @map("max_uses")
  usesCount       Int              @default(0) @map("uses_count")
  maxUsesPerUser  Int              @default(1) @map("max_uses_per_user")
  validFrom       DateTime?        @map("valid_from")
  validTo         DateTime?        @map("valid_to")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  orders          CustomerOrder[]
  redemptions     PromoRedemption[]

  @@map("promo_codes")
}

/// Jedna realizacja kodu na zamówienie; służy do limitu „na użytkownika”.
model PromoRedemption {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  promoCodeId String   @map("promo_code_id")
  orderId     String   @unique @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, promoCodeId])
  @@map("promo_redemptions")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model ProductReview {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  rating    Int
  comment   String?  @db.Text
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, isVisible])
  @@map("product_reviews")
}

model CustomerOrderItem {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  productId String        @map("product_id")
  name      String
  price     Decimal       @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal       @db.Decimal(12, 2) @map("line_total")
  createdAt DateTime      @default(now()) @map("created_at")
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("customer_order_items")
}

model AvailabilityWatch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("availability_watches")
}

model AddressBookEntry {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  label             String?
  entryType         AddressBookEntryType @default(ADDRESS) @map("entry_type")
  recipientName     String?              @map("recipient_name")
  phone             String?
  email             String?
  /// Domyślny kraj sklepu (PL); pełna lista dozwolonych — `SHOP_SUPPORTED_COUNTRIES` / walidacja w OrderService.
  country           String               @default("PL")
  postalCode        String?              @map("postal_code")
  city              String?
  street            String?
  buildingNumber    String?              @map("building_number")
  apartmentNumber   String?              @map("apartment_number")
  parcelLockerId    String?              @map("parcel_locker_id")
  parcelLockerLabel String?              @map("parcel_locker_label")
  isDefault         Boolean              @default(false) @map("is_default")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("address_book_entries")
}

model CheckoutPreference {
  userId                String         @id @map("user_id")
  preferredPaymentMethod PaymentMethod? @map("preferred_payment_method")
  preferredShippingMethod ShippingMethod? @map("preferred_shipping_method")
  preferredAddressId     String?        @map("preferred_address_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@map("checkout_preferences")
}
