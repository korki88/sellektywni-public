generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  AVAILABLE
  PENDING_APPROVAL
  SOLD
  IN_FITTING_ROOM
}

/// Produkt zsynchronizowany z Dotykačką (id_dotykacka = identyfikator w chmurze Dotykačka).
model Product {
  id          String        @id @default(uuid())
  idDotykacka String        @unique @map("id_dotykacka")
  name        String
  price       Decimal       @db.Decimal(12, 2)
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("products")
}
