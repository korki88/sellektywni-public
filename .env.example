DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellektywni?schema=public"
PORT=3000

# Supabase — Settings → API → JWT Secret (weryfikacja access tokena po stronie API)
SUPABASE_JWT_SECRET=

# Flutter Web: przy buildzie przekaż jako --dart-define (URL + klucz anon z API Supabase)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# API_BASE_URL=http://localhost:3000

# Dotykačka API v2 — dokumentacja: https://docs.api.dotykacka.cz/
DOTYKACKA_BASE_URL=https://api.dotykacka.cz/v2
DOTYKACKA_CLOUD_ID=
DOTYKACKA_ACCESS_TOKEN=

# Powiadomienia admina: log + opcjonalnie webhook POST (JSON)
ADMIN_WEBHOOK_URL=
